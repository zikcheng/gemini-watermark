{
  "format_version": 1,
  "name": "sobel-magnitude",
  "cv2_version": "5.0.0",
  "command": "python3 tools/reference/dump_imageops.py --only sobel-magnitude",
  "description": "3x3 Sobel magnitude on float32 input, the stage-2 edge signature. Every `input` is an array key holding the exact float32 cv2 was handed \u2014 the grayscale scaling uses OpenCV's float32 work type while the port divides in float64 (docs/plan/DEVIATIONS.md D4), so the input is dumped rather than recomputed.",
  "operation": "magnitude(Sobel(src, CV_32F, 1, 0, ksize=3), Sobel(src, CV_32F, 0, 1, ksize=3))",
  "sobel_params": {
    "ddepth": "CV_32F",
    "ksize": 3,
    "scale": 1,
    "delta": 0,
    "borderType": "BORDER_DEFAULT (BORDER_REFLECT_101)"
  },
  "inputs": [
    {
      "label": "v1-small-800x600",
      "source": {
        "kind": "case_file",
        "path": "v1-small-800x600/blend-watermarked.png"
      },
      "input": "v1-small-800x600-gray-f32",
      "output": "v1-small-800x600-magnitude"
    },
    {
      "label": "v2-large-2752x1536",
      "source": {
        "kind": "case_file",
        "path": "v2-large-2752x1536/blend-watermarked.png"
      },
      "input": "v2-large-2752x1536-gray-f32",
      "output": "v2-large-2752x1536-magnitude"
    },
    {
      "label": "v2-small-1024x572",
      "source": {
        "kind": "case_file",
        "path": "v2-small-1024x572/blend-watermarked.png"
      },
      "input": "v2-small-1024x572-gray-f32",
      "output": "v2-small-1024x572-magnitude"
    },
    {
      "label": "synthetic-16x32",
      "source": {
        "kind": "array",
        "note": "generated by synthetic_full_range()"
      },
      "input": "synthetic-16x32-gray-f32",
      "output": "synthetic-16x32-magnitude"
    },
    {
      "label": "v2-96-alpha",
      "source": {
        "kind": "alpha_map",
        "variant": "V2",
        "size": "large"
      },
      "input": "v2-96-alpha",
      "output": "v2-96-alpha-magnitude"
    }
  ],
  "arrays": {
    "v1-small-800x600-gray-f32": {
      "file": "sobel-magnitude-v1-small-800x600-gray-f32.bin",
      "dtype": "float32",
      "shape": [
        64,
        64
      ]
    },
    "v1-small-800x600-magnitude": {
      "file": "sobel-magnitude-v1-small-800x600-magnitude.bin",
      "dtype": "float32",
      "shape": [
        64,
        64
      ]
    },
    "v2-large-2752x1536-gray-f32": {
      "file": "sobel-magnitude-v2-large-2752x1536-gray-f32.bin",
      "dtype": "float32",
      "shape": [
        112,
        112
      ]
    },
    "v2-large-2752x1536-magnitude": {
      "file": "sobel-magnitude-v2-large-2752x1536-magnitude.bin",
      "dtype": "float32",
      "shape": [
        112,
        112
      ]
    },
    "v2-small-1024x572-gray-f32": {
      "file": "sobel-magnitude-v2-small-1024x572-gray-f32.bin",
      "dtype": "float32",
      "shape": [
        52,
        52
      ]
    },
    "v2-small-1024x572-magnitude": {
      "file": "sobel-magnitude-v2-small-1024x572-magnitude.bin",
      "dtype": "float32",
      "shape": [
        52,
        52
      ]
    },
    "synthetic-16x32-gray-f32": {
      "file": "sobel-magnitude-synthetic-16x32-gray-f32.bin",
      "dtype": "float32",
      "shape": [
        32,
        16
      ]
    },
    "synthetic-16x32-magnitude": {
      "file": "sobel-magnitude-synthetic-16x32-magnitude.bin",
      "dtype": "float32",
      "shape": [
        32,
        16
      ]
    },
    "v2-96-alpha-magnitude": {
      "file": "sobel-magnitude-v2-96-alpha-magnitude.bin",
      "dtype": "float32",
      "shape": [
        96,
        96
      ]
    },
    "v2-96-alpha": {
      "file": "sobel-magnitude-v2-96-alpha.bin",
      "dtype": "float32",
      "shape": [
        96,
        96
      ]
    }
  }
}
