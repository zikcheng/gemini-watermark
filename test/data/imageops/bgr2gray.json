{
  "format_version": 1,
  "name": "bgr2gray",
  "cv2_version": "5.0.0",
  "command": "python3 tools/reference/dump_imageops.py --only bgr2gray",
  "description": "COLOR_BGR2GRAY on uint8 BGR input; output uint8. The port applies the fixed-point coefficients to its RGB buffer, which is the same pixels with the channel axis reversed.",
  "operation": "cv2.cvtColor(src, cv2.COLOR_BGR2GRAY)",
  "inputs": [
    {
      "label": "v1-small-800x600",
      "source": {
        "kind": "case_file",
        "path": "v1-small-800x600/blend-watermarked.png"
      },
      "height": 64,
      "width": 64,
      "channel_order": "BGR",
      "output": "v1-small-800x600-gray"
    },
    {
      "label": "v2-large-2752x1536",
      "source": {
        "kind": "case_file",
        "path": "v2-large-2752x1536/blend-watermarked.png"
      },
      "height": 112,
      "width": 112,
      "channel_order": "BGR",
      "output": "v2-large-2752x1536-gray"
    },
    {
      "label": "v2-small-1024x572",
      "source": {
        "kind": "case_file",
        "path": "v2-small-1024x572/blend-watermarked.png"
      },
      "height": 52,
      "width": 52,
      "channel_order": "BGR",
      "output": "v2-small-1024x572-gray"
    },
    {
      "label": "synthetic-16x16",
      "source": {
        "kind": "array",
        "note": "generated by synthetic_full_range()"
      },
      "height": 16,
      "width": 16,
      "channel_order": "BGR",
      "output": "synthetic-16x16-gray"
    }
  ],
  "arrays": {
    "v1-small-800x600-gray": {
      "file": "bgr2gray-v1-small-800x600-gray.bin",
      "dtype": "uint8",
      "shape": [
        64,
        64
      ]
    },
    "v2-large-2752x1536-gray": {
      "file": "bgr2gray-v2-large-2752x1536-gray.bin",
      "dtype": "uint8",
      "shape": [
        112,
        112
      ]
    },
    "v2-small-1024x572-gray": {
      "file": "bgr2gray-v2-small-1024x572-gray.bin",
      "dtype": "uint8",
      "shape": [
        52,
