      "shape": [
        16,
        16
      ]
    },
    "synthetic-16x16-input": {
      "file": "bgr2gray-synthetic-16x16-input.bin",
      "dtype": "uint8",
      "shape": [
        16,
        16,
        3
      ]
    }
  }
}
