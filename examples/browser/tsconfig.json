{
  // Separate from the root config on purpose. The root deliberately omits
  // the DOM lib so that a stray `document.` in `src/` fails to compile;
  // this example is the environment-specific layer and needs it.
  //
  // `paths` resolves the package to its **built declarations** rather than
  // to `src/`, so the example is typechecked against the exact surface a
  // consumer installs -- a type that never made it through the dts build
  // fails here. That is why `npm run check` runs this after `build`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // Without this, TypeScript loads every @types package it can find --
    // including @types/node from the repository root -- and `process` or
    // `Buffer` would compile in a file that runs in a browser. The empty
    // list is what makes this config an environment boundary rather than a
    // lib list.
    "types": [],
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "gemini-watermark": ["../../dist/index.d.ts"]
    }
  },
  "include": ["main.ts"]
}
